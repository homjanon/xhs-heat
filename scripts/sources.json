  "llm": {
    "comment": "模型链（polo 2026-11-26 定稿）：Agnes 主力 → Gemini 备份 → SenseNova 末位。429 冷却 60s 后重试；403/404/410 永久跳过；全失败走词典口径。",
    "chains": {
      "extract": {
        "purpose": "实体抽取长尾（词典未命中的片段）+ 语境判断",
        "models": [
          {
            "name": "Agnes agnes-3.0-flash",
            "api_url": "https://apihub.agnes-ai.com/v1/chat/completions",
            "api_key_env": "AGNES_API_KEY",
            "model": "agnes-3.0-flash",
            "note": "主力（polo 2026-11-26 决定）：免费不限量；关闭内部思考避免挤空可见输出",
            "thinking_off": true
          },
          {
            "name": "Gemini 3.5 Flash-Lite",
            "api_url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
            "api_key_env": "GEMINI_API_KEY",
            "model": "gemini-3.5-flash-lite",
            "note": "第二档：额度独立"
          },
          {
            "name": "SenseNova deepseek-flash",
            "api_url": "https://token.sensenova.cn/v1/chat/completions",
            "api_key_env": "SENSENOVA_API_KEY",
            "model": "deepseek-flash",
            "note": "末位（实测该 key RPM 极紧，每批首调常 429，不适合主力）",
            "reasoning_effort_low": true
          }
        ]
      },
      "classify": {
        "purpose": "意图五分类（学/买/晒/愁/广）",
        "models_ref": "extract.models（复用同一条链）",
        "anchor_requirement": "prompt 必须做标签锚定：每类给 3 个例句 + 明确写『不要把所有笔记归入同一类』（ai-radar 分数锚定坑）",
        "fallback": "关键词规则兜底分类（v1 式词表），输出标『降级口径』"
      }
    },
    "limits": {
      "max_notes_for_llm": 500,
      "batch_size": 20,
      "timeout_s": 75,
      "min_text_len": 12,
      "comment": "词典先行后仅长尾进 LLM；单批失败只丢该批，绝不中断整批",
      "rate_limit_cooldown_s": 60
    },
    "budget": {
      "expected_daily_calls": "词典先行后约 200-400 条长尾，10-20 批",
      "circuit_breaker": "429 → 该档冷却 60s 后允许重试（不整轮拉黑）；403/404/410 → 永久跳过；503/超时 → 换下一档；全部失败 → 词典口径"
    }
  },
